# Server
PORT=3
# Comma-separated list of allowed origins for CORS
CORS_ORIGIN=

# Database — defaults to a local SQLite file for zero-config dev.
# For Postgres set DB_DIALECT=postgres and fill the rest.
DB_DIALECT=
DB_STORAGE=

# To use Postgres, change DB_DIALECT=postgres and set the following values.
# Example:
DB_DIALECT=
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

# Used when DB_DIALECT=postgres (or mysql)
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_NAME=yuba_leads
# DB_USER=postgres
# DB_PASSWORD=postgres
